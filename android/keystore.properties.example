# Copy to android/keystore.properties and fill in. That file is gitignored -
# never commit a keystore or its passwords.
#
# Without it, `assembleRelease` produces an UNSIGNED artifact. That is deliberate:
# the previous behaviour signed release builds with the public debug keystore,
# which Play rejects and which lets any same-identity APK update an installed app.
#
# storeFile is resolved relative to android/app, so an absolute path is safest.

storeFile=/absolute/path/to/modernbody-release.jks
storePassword=
keyAlias=
keyPassword=
