<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (minSdk is 26, so this still matters).

  The pre-Android-12 backup API has no cloud/device-transfer split - it is one
  switch. Since the point is to keep body photos and the meal log out of Google
  Drive, everything is excluded here.

  The trade-off is explicit: on Android 11 and below there is no backup at all,
  so a user changing handsets starts fresh. On 12+ device-to-device transfer
  still works; see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
