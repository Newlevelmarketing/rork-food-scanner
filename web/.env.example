# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.

# Server-side only. Read by api/analyze.ts, which runs on the host (or in the
# vite dev middleware), never in the browser.
#
# CRITICAL: do not rename this with a VITE_ or EXPO_PUBLIC_ prefix. Vite inlines
# prefixed variables into the client bundle, which is exactly how the previous
# gateway key ended up shipped to every user.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# Confirm the current model id against Google's documentation before deploying.
GEMINI_MODEL=

# Optional, client-side. A URL, not a credential. Only needed if the analysis
# proxy is served from a different origin than the app.
# VITE_ANALYZE_ENDPOINT=
